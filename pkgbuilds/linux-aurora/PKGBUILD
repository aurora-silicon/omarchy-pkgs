# AArch64 Apple Silicon (Aurora Silicon)
# Based on the asahi-alarm linux-asahi package by Jos Dehaes and Matthias Kurz.
#
# Aurora Silicon maintain a fork of the Asahi kernel carrying DisplayPort
# alt-mode and USB4 support for external monitors, variable refresh rate, the
# ISP and AOP drivers, and the MacBook Neo (J700, T8140). Those changes touch
# device trees, the type-C stack and DRM, so they cannot ship as a module:
# this is a whole alternative kernel for Macs on the Omarchy edge channel.
#
# This build is the Neo beta kernel: public aurora-silicon/linux aurora-wip at
# the pin below, configured from aurora_j700_defconfig (`make savedefconfig`
# of the configuration the Neo booted on 2026-10-15). Everything comes from
# public sources and builds offline once the sources are fetched.

_auroraver=7.1.12
pkgrel=1

# Immutable pin on aurora-silicon/linux (branch aurora-wip). 5f6c917 merges
# #301, which leaves the firmware-owned J700 DISP_CPU domain alone: without it
# the Neo does not boot.
_commit=5f6c917f2c824b3c87497e8bd7dd92a6de0efe60

_m1n1_version=1.6.1

pkgbase=linux-aurora
_srcname=linux-${_commit}
_desc="AArch64 Apple Silicon (Aurora kernel)"
# The date sorts above the edge channel's 7.1.12.aurora<N> builds.
pkgver="${_auroraver}.aurora20261015"
arch=('aarch64')
url="https://github.com/aurora-silicon/linux"
license=('GPL-2.0-only')

# LLVM 22, as the Neo kernel was built and tools/aurora-bindgen was qualified:
# with LLVM 23 the kernel switches CC_MS_EXTENSIONS to -fms-anonymous-structs
# and bindgen again gets the anonymous namespace members wrong.
_llvm=22
makedepends=(
  base-devel bc cpio dtc kmod libelf pahole patch perl python tar xz
  "clang${_llvm}" "lld${_llvm}" "llvm${_llvm}" llvm rust rust-src
)
options=('!strip' '!debug')
_bindgen=0.73.2
source=(
  "linux-${_commit}.tar.gz::https://github.com/aurora-silicon/linux/archive/${_commit}.tar.gz"
  "rust-bindgen-${_bindgen}.tar.gz::https://codeload.github.com/rust-lang/rust-bindgen/tar.gz/refs/tags/v${_bindgen}"
  aurora_j700_defconfig
)
# tools/aurora-bindgen/build.py checks and unpacks the bindgen archive itself.
noextract=("rust-bindgen-${_bindgen}.tar.gz")
sha256sums=('13d3537fcc7ba6698a4933a5548cb636d4b0c17cc314b5989cc833c9b2e441cf'
            '5fc3277dd334e4bbbd7bdb8cad5d4fb87a667b2e95a2bae350a8d5424c280629'
            'e1f2b2608c5c19eb362278ef75031e29683f736f2e6fe4418d8e3375318df07d')

# Kbuild takes ARCH literally and knows arm64, not aarch64.
export ARCH=arm64
# Clang, LLD and the LLVM binutils, as the Neo kernel was built; this also
# makes INSTALL_MOD_STRIP use llvm-strip. Arch Linux ARM installs the
# versioned LLVM under its own prefix only, and bindgen loads its libclang.
export LLVM=1
export PATH="/usr/lib/llvm${_llvm}/bin:$PATH"
export LIBCLANG_PATH="/usr/lib/llvm${_llvm}/lib"
export KBUILD_BUILD_HOST=archlinux
export KBUILD_BUILD_USER=$pkgbase
export KBUILD_BUILD_TIMESTAMP="$(date -Ru${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH})"

# The kernel's Rust bindings need the in-tree patched bindgen
# (tools/aurora-bindgen): stock bindgen 0.73.2 gets the layout of anonymous
# members wrong and the build stops on the layout assertions.
# The top Makefile assigns BINDGEN, so it is passed on each make command line.
_use_aurora_bindgen() {
  export BINDGEN="$srcdir/aurora-bindgen/rust-bindgen-${_bindgen}/target/release/bindgen"
}

prepare() {
  cd $_srcname

  _use_aurora_bindgen
  if [[ ! -x $BINDGEN ]]; then
    echo "Building the kernel's bindgen..."
    # Fetches the crates bindgen's Cargo.lock pins; everything after this
    # function runs offline.
    rm -rf "$srcdir/aurora-bindgen"
    python3 tools/aurora-bindgen/build.py --archive "$srcdir/rust-bindgen-${_bindgen}.tar.gz" \
      --output-dir "$srcdir/aurora-bindgen"
  fi

  echo "Setting config..."
  mkdir -p build/base
  install -m644 ../aurora_j700_defconfig arch/arm64/configs/aurora_j700_defconfig
  make O="$PWD/build/base" BINDGEN="$BINDGEN" aurora_j700_defconfig
  # The release names the commit: 7.1.12-aurora-g5f6c917-ARCH. It ends in
  # -ARCH because asahi-scripts' update-m1n1 takes its device trees from the
  # newest /lib/modules/*-ARCH/dtbs unless /etc/default/update-m1n1 says
  # otherwise, and omarchy-mac-boot keeps that default.
  # A warning from a newer compiler than the one the configuration was
  # qualified with must not fail a distribution build (the in-tree
  # asahi.config fragment turns WERROR off for the same reason).
  scripts/config --file build/base/.config \
    --set-str LOCALVERSION "-aurora-g${_commit::7}-ARCH" \
    --disable LOCALVERSION_AUTO \
    --disable WERROR
  make O="$PWD/build/base" BINDGEN="$BINDGEN" olddefconfig prepare
  make -s O="$PWD/build/base" BINDGEN="$BINDGEN" kernelrelease > build/base/version
  grep -qx "CONFIG_CLANG_VERSION=${_llvm}[0-9]\{4\}" build/base/.config || {
    echo "linux-aurora needs clang ${_llvm}" >&2; return 1; }

  echo "Prepared $pkgbase version $(<build/base/version)"
}

build() {
  cd $_srcname
  _use_aurora_bindgen
  echo "Building base..."
  make O="$PWD/build/base" BINDGEN="$BINDGEN" -j"$(nproc)" Image modules dtbs
}

_package_kernel() {
  pkgdesc="The $_desc kernel and modules"
  depends=(coreutils kmod initramfs "m1n1>=$_m1n1_version")
  optdepends=('wireless-regdb: to set the correct wireless channels of your country'
              'linux-firmware: firmware images needed for some devices')
  # No generic linux provide: on a shared aarch64 repository it would compete
  # with linux-aarch64 for any dependency on linux.
  provides=(WIREGUARD-MODULE linux-asahi=${pkgver})
  conflicts=(linux-asahi)

  local kernver="$(<$O/version)"
  local modulesdir="$pkgdir/usr/lib/modules/$kernver"

  echo "Installing boot image..."
  # systemd expects to find the kernel here to allow hibernation
  # https://github.com/systemd/systemd/commit/edda44605f06a41fb86b7ab8128dcf99161d2344
  install -Dm644 "$O"/arch/arm64/boot/Image "$modulesdir/vmlinuz"

  # Used by mkinitcpio to name the kernel
  echo "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"

  echo "Installing modules..."
  # Stripped: the unstripped modules (405 MB) give a 100 MB initramfs that
  # hung the Neo's first boot.
  make O="$O" BINDGEN="$BINDGEN" INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 modules_install

  echo "Installing device trees..."
  # Flat, where update-m1n1 and the Omarchy Mac image builder read them
  # (t8140-j700.dtb among them).
  install -Dt "$modulesdir/dtbs" -m644 "$O"/arch/arm64/boot/dts/apple/*.dtb
  [[ -f $modulesdir/dtbs/t8140-j700.dtb ]] || { echo "no J700 device tree" >&2; return 1; }

  echo "Installing the build configuration..."
  install -Dm644 "$O"/.config "$pkgdir/usr/share/doc/$pkgbase/build.config"

  # remove build and source links
  rm -f "$modulesdir"/{source,build}
}

_package() {
  cd $_srcname
  _use_aurora_bindgen
  export O="$PWD/build/base"
  _package_kernel
}

_package-headers() {
  pkgdesc="Headers and scripts for building modules for the $_desc kernel"
  depends=(pahole)
  provides=(linux-asahi-headers=${pkgver})
  conflicts=(linux-asahi-headers)

  KARCH=arm64

  cd $_srcname
  _use_aurora_bindgen
  O=build/base
  local builddir="$pkgdir/usr/lib/modules/$(<${O}/version)/build"

  echo "Installing build files..."
  install -Dt "$builddir" -m644 $O/.config Makefile $O/Module.symvers $O/System.map \
    $O/version $O/vmlinux
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  cp -t "$builddir" -a scripts $O/scripts

  # required when DEBUG_INFO_BTF_MODULES is enabled
  if [[ -e $O/tools/bpf/resolve_btfids/resolve_btfids ]]; then
    install -Dt "$builddir/tools/bpf/resolve_btfids" $O/tools/bpf/resolve_btfids/resolve_btfids
  fi

  echo "Installing headers..."
  cp -t "$builddir" -a include $O/include

  install -Dt "${builddir}/arch/${KARCH}" -m644 arch/${KARCH}/Makefile
  install -Dt "${builddir}/arch/${KARCH}/kernel" -m644 $O/arch/${KARCH}/kernel/asm-offsets.s
  cp -t "${builddir}/arch/${KARCH}" -a arch/${KARCH}/include $O/arch/${KARCH}/include

  install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
  install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h

  # https://bugs.archlinux.org/task/13146
  install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h

  # https://bugs.archlinux.org/task/20402
  install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
  install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
  install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h

  # https://bugs.archlinux.org/task/71392
  install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h

  echo "Installing KConfig files..."
  find . -path ./build -prune -o -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;

  # Rust: out-of-tree Rust modules need the kernel crate metadata.
  if [[ -d $O/rust ]]; then
    echo "Installing Rust metadata..."
    install -Dt "$builddir/rust" -m644 $O/rust/*.rmeta
    install -Dt "$builddir/rust" $O/rust/*.so
  fi

  echo "Installing unstripped VDSO..."
  make O="$O" BINDGEN="$BINDGEN" INSTALL_MOD_PATH="$pkgdir/usr" vdso_install link=

  echo "Removing unneeded architectures..."
  local arch
  for arch in "$builddir"/arch/*/; do
    [[ $arch = */${KARCH}/ ]] && continue
    echo "Removing $(basename "$arch")"
    rm -r "$arch"
  done

  echo "Removing documentation..."
  rm -rf "$builddir/Documentation"

  echo "Removing broken symlinks..."
  find -L "$builddir" -type l -printf 'Removing %P\n' -delete

  echo "Removing loose objects..."
  find "$builddir" -type f -name '*.o' -printf 'Removing %P\n' -delete

  echo "Removing cmd files..."
  find "$builddir" -type f -name '*.cmd' -printf 'Removing %P\n' -delete

  echo "Stripping build tools..."
  local file
  while read -rd '' file; do
    case "$(file --no-sandbox -bi "$file")" in
      application/x-sharedlib\;*)      # Libraries (.so)
        llvm-strip $STRIP_SHARED "$file" ;;
      application/x-archive\;*)        # Libraries (.a)
        llvm-strip $STRIP_STATIC "$file" ;;
      application/x-executable\;*)     # Binaries
        llvm-strip $STRIP_BINARIES "$file" ;;
      application/x-pie-executable\;*) # Relocatable binaries
        llvm-strip $STRIP_SHARED "$file" ;;
    esac
  done < <(find "$builddir" -type f -perm -u+x ! -name vmlinux ! -path '*/rust/*' -print0)

  echo "Stripping vmlinux..."
  llvm-strip $STRIP_STATIC "$builddir/vmlinux"

  echo "Adding symlink..."
  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}

pkgname=("$pkgbase" "$pkgbase-headers")
for _p in "${pkgname[@]}"; do
  eval "package_$_p() {
    $(declare -f "_package${_p#$pkgbase}")
    _package${_p#$pkgbase}
  }"
done

# vim:set ts=8 sts=2 sw=2 et:
