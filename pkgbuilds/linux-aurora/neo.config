# Extend the shared config with Neo drivers and missing common capabilities.
# Existing enabled settings, CLPC and the STEP_WISE thermal default stay intact.
CONFIG_PCIE_APPLE_PIODMA_DIAG=y
CONFIG_MT7932_FULLMAC=m
CONFIG_BT_MTK7932_PCIE=m
CONFIG_SPI_APPLE_QSPI=m
CONFIG_RTC_DRV_APPLE_PMU=m
# These drivers bind only to matching hardware.
# power_allocator remains available; switching the shared governor needs qualification.
CONFIG_SND_SOC_APPLE_T8140_AOP_AUDIO=m
CONFIG_DRM_ACCEL_ANE=m
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL_EARLYCON=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
CONFIG_THERMAL_NETLINK=y
CONFIG_NVME_HWMON=y
CONFIG_TRUSTED_KEYS=m
