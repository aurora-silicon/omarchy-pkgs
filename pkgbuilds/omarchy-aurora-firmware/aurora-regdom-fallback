#!/bin/bash
# The MT7932 radio takes its regulatory policy from
# /usr/lib/firmware/mediatek/mt7932/policy/<country>.bin and stays blocked for
# a country without one. Whenever the regulatory domain lands on such a
# country, switch to the world domain, whose policy is world-XZ.bin, so the
# radio comes up with the most restrictive rules instead of not at all.
policy=/usr/lib/firmware/mediatek/mt7932/policy

fall_back() {
  local country
  country=$(iw reg get | awk '$1 == "country" { sub(":", "", $2); print $2; exit }')
  [[ $country =~ ^[A-Z]{2}$ && ! -e $policy/$country.bin ]] || return 0
  echo "No MT7932 policy for $country; using the world regulatory domain"
  iw reg set 00
}

iw event | while read -r line; do
  [[ $line == *"regulatory domain change"* ]] && fall_back
done &
watcher=$!

# An initramfs built before it carried regulatory.db left cfg80211 without
# one, and a country set then reaches the driver but not the global domain,
# so nothing above would see it. Load the database from the root filesystem
# and set the configured country again, now for real.
iw reg reload
[[ ! -x /usr/bin/set-wireless-regdom ]] || /usr/bin/set-wireless-regdom
fall_back
wait "$watcher"
