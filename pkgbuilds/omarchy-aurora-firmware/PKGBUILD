pkgname=omarchy-aurora-firmware
pkgver=20261014
pkgrel=1
pkgdesc='Order Apple peripheral admission after device firmware extraction'
arch=('aarch64')
license=('MIT')
url='https://github.com/aurora-silicon/omarchy-mac'
depends=('kmod' 'omarchy-mac-boot' 'linux-aurora>=7.1.12.aurora5')
source=(aurora-firmware-order.conf aurora-peripheral-firmware.sh
        aurora-peripheral-firmware.service aurora-vendor-order.install
        95-aurora-vendor-order.conf aurora-vendor-order-cryptsetup.conf
        20-aurora-vendor-order.conf)
sha256sums=('e6338787cc03c7704589df20f7551ac17bc2ae25aa2f8df3b6d9532a1c5b79f9' '70f1fcc7890963fe9d7efda0da6f917557a7278371586c4fc2962c1b1c7cc197' '328c689685f21bb760f3bea7984b42060a04f6a386d4a35b8237de95328ccc31' '94f028f9537b69ddc7c3eed03586718066132b7cd18b0b7ed5e98ca3e1308195' '8ef54ee9d0f438864f2a99bbb8c0cf53aa8b7e0e217bd74b2fd324ff0b882a32' '298c2abc4c0e11ab03470209b4ff93c184eed40d3cf9e1913e41ba0ea0179837' 'e200d1cf003d60eca4a825aec9475f36dd8db6a5a8805eaac93e3fecfa0b3cb0')
package() {
  install -Dm644 aurora-firmware-order.conf "$pkgdir/usr/lib/modprobe.d/aurora-firmware-order.conf"
  install -Dm755 aurora-peripheral-firmware.sh "$pkgdir/usr/lib/omarchy/initcpio/aurora-peripheral-firmware.sh"
  install -Dm644 aurora-peripheral-firmware.service "$pkgdir/usr/lib/systemd/system/aurora-peripheral-firmware.service"
  install -Dm755 aurora-vendor-order.install "$pkgdir/usr/lib/initcpio/install/aurora-vendor-order"
  install -Dm644 95-aurora-vendor-order.conf "$pkgdir/etc/mkinitcpio.conf.d/95-aurora-vendor-order.conf"
  install -Dm644 aurora-vendor-order-cryptsetup.conf "$pkgdir/usr/lib/omarchy/initcpio/aurora-vendor-order-cryptsetup.conf"
  install -Dm644 20-aurora-vendor-order.conf "$pkgdir/usr/lib/systemd/system/omarchy-vendor-firmware.service.d/20-aurora-vendor-order.conf"
}
