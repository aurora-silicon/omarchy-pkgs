# U-Boot for Apple Silicon Macs from aurora-silicon/u-boot aurora-wip: Asahi's
# U-Boot plus the MacBook Neo (J700, T8140) support, built as published with
# no local patches. Named uboot-asahi, like Omarchy's and asahi-alarm's build,
# because update-m1n1 and the Omarchy Mac image take U-Boot from that package.
pkgname=uboot-asahi
_ver=2026.07
pkgver=${_ver}.aurora20261015
pkgrel=1
pkgdesc='U-Boot for Apple Silicon Macs, including the MacBook Neo (Aurora aurora-wip)'
arch=('aarch64')
url='https://github.com/aurora-silicon/u-boot'
license=('GPL-2.0-or-later')
makedepends=('bc' 'dtc' 'openssl' 'python' 'python-pyelftools' 'python-setuptools' 'swig')
options=('!strip' '!debug' '!lto')
_commit=0cb6fed6a10512d1013a4a80b6d83c3d56140f2f
_srcname=u-boot-${_commit}
source=("u-boot-${_commit}.tar.gz::https://github.com/aurora-silicon/u-boot/archive/${_commit}.tar.gz")
sha256sums=('a9ffcf72f82c4da3e0f26c0675936d3a3f6134c4ae12eda7795e9fcbfb58ed05')

build() {
  cd "$_srcname"
  unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
  make O=build PYTHON3=/usr/bin/python3 apple_m1_defconfig
  make O=build PYTHON3=/usr/bin/python3 -j"$(nproc)"
}

package() {
  cd "$_srcname"
  # The device trees come from linux-aurora; update-m1n1 appends this image
  # after them in m1n1's Stage 2.
  install -Dm644 build/u-boot-nodtb.bin "$pkgdir/usr/lib/asahi-boot/u-boot-nodtb.bin"
  install -Dm644 build/.config "$pkgdir/usr/share/doc/$pkgname/build.config"
  # The Macs this U-Boot supports, as asahi-alarm's uboot-asahi lists them:
  # the image builder checks that linux-aurora has a device tree for each.
  local dtb model count=0
  for dtb in build/dts/upstream/src/arm64/apple/*.dtb; do
    model=$(fdtget "$dtb" / model)
    case "$model" in
      'Apple Mac'*|'Apple iMac'*)
        install -Dm644 "$dtb" "$pkgdir/usr/lib/asahi-boot/dtb/${dtb##*/}"
        count=$((count + 1))
        ;;
    esac
  done
  ((count > 0)) || { echo 'No compiled Apple Silicon Mac device trees' >&2; return 1; }
  install -Dm644 Licenses/gpl-2.0.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  printf '%s\n' "$_commit" > "$pkgdir/usr/share/doc/$pkgname/source-revision"
}
