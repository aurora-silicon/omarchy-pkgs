post_install() {
  cat <<'MSG'
==> This package supplies asahi_drv_video.so and aurora_drv_video.so aliases
    so libva can discover the decoder on older and current Aurora kernels.

    If something does not, select it explicitly for the session:

        LIBVA_DRIVER_NAME=v4l2_request

==> Check normal discovery with: env -u LIBVA_DRIVER_NAME vainfo --display drm
==> mpv:         mpv --hwdec=vaapi video.mp4
==> Browsers:    validate with the normal media sandbox enabled. Discovery
                 and advertised profiles alone do not prove hardware decoding.
MSG
}

post_upgrade() {
  post_install
}
